{
  "name": "verba-workplace-translator",
  "version": "1.1.0",
  "description": "Context-aware workplace Chinese-English translator",
  "main": "electron-main.cjs",
  "author": "Verba",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "node scripts/check-i18n.mjs && node --test tests/*.test.mjs",
    "pack": "electron-builder --dir",
    "dist": "node scripts/prepare-electron-builder.cjs && electron-builder --win nsis --publish never",
    "release": "npm run dist"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.verba.workplace-translator",
    "productName": "Verba",
    "asar": true,
    "files": [
      "**/*",
      "!dist/**",
      "!tests/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
    "shortcutName": "Verba"
    },
    "publish": [{
      "provider": "github",
      "owner": "guanchengwang11-ux",
      "repo": "Verba",
      "releaseType": "release"
    }],
    "electronUpdaterCompatibility": ">= 2.16"
  }
}
